<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app talks HTTPS to OpenRouter. Cleartext is off everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Loopback and the Android emulator host alias are the only cleartext
         destinations allowed, for a locally hosted glasses bridge. A bridge
         on any other host must use wss://. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
