<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>

        <!-- Settings and API key material stay on this device. -->
        <exclude domain="file" path="datastore/vesper_settings.preferences_pb"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="vesper_secure_prefs.xml"/>
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="."/>

        <!-- A new device cannot use the old Keystore key, so the encrypted
             key file and the settings DataStore are excluded from transfer. -->
        <exclude domain="file" path="datastore/vesper_settings.preferences_pb"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="vesper_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
